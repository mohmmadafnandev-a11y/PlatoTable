# Copy to `.env.local` for local work, and set the same names in the hosting
# project (Vercel → Project → Settings → Environment Variables). Env files are
# never uploaded anywhere: Vercel reads its dashboard variables, and this repo
# ignores every .env* file except this example.
# Anything without a VITE_ prefix is server-only: it is read by /api functions
# and must never be exposed to the browser.

# ── Browser bundle ───────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
VITE_APP_NAME=Plato Table
# Shown on the customer menu when the request carries no tenant of its own.
VITE_RESTAURANT_NAME=Your Restaurant
# Optional fallback tenant slug (a bare domain or /:slug path normally wins).
VITE_RESTAURANT_SLUG=your-restaurant-slug

# The deployment's fixed public address. Used for printed QR codes and as the
# fallback when a request carries no host of its own. Links shown in the admin
# panel are built from the host the operator is actually using, so this is NOT
# read for those — leave it as your production origin.
VITE_CANONICAL_BASE_URL=https://your-app.example.com

# ── Server-only ──────────────────────────────────────────────────────────────
# Bypasses row level security. Required by every /api function.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Billing is Safepay, Pakistan only, in PKR. Set SAFEPAY_ENV to `sandbox` while
# testing and `production` once real charges are wanted; it selects which Safepay
# hosts are called. Nothing in the UI states the mode, so a wrong value here is
# silent — double check it before deploying. Anything that is not exactly
# `production` is treated as sandbox, so a forgotten variable cannot charge a
# real card.
SAFEPAY_ENV=sandbox
# Merchant (public) key from Safepay dashboard → Developers → API.
SAFEPAY_MERCHANT_KEY=sec_...
# Merchant secret. Server only: it authenticates every Safepay API call.
SAFEPAY_SECRET_KEY=...
# Webhook HMAC key from Safepay dashboard → Developers → Endpoints (shown per
# endpoint — it is NOT the secret key above). Required for every incoming
# webhook: without it signatures cannot be verified and Safepay events are
# rejected.
SAFEPAY_WEBHOOK_SECRET=...

# Optional overrides, only needed against a Safepay host that is not one of the
# two standard pairs (sandbox / production) baked into api/_lib/safepay.js.
# SAFEPAY_HOST=https://sandbox.api.getsafepay.com
# SAFEPAY_CHECKOUT_HOST=https://sandbox.api.getsafepay.com

# Shared secret for the scheduled jobs (api/billing/sweep.js, api/rates.js).
# Without it those endpoints refuse to run unless Vercel's own cron header is
# present.
CRON_SECRET=your-cron-secret

# Optional. Only needed by the platform-staff exchange-rate cache (api/rates.js),
# which is not part of billing — every price is quoted in PKR. Set it to a
# free-tier key from exchangerate-api.com to refresh that cache.
EXCHANGE_RATE_API_KEY=your-exchangerate-api-key
